{
  "name": "meal-planning-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "concurrently \"vite dev --port 3213\" \"convex dev\"",
    "dev:vite": "vite dev --port 3213",
    "dev:convex": "convex dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:prod": "bash scripts/deploy.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "check": "biome check",
    "check:fix": "biome check --fix",
    "types:check": "tsc --noEmit",
    "knip": "knip",
    "check:full": "pnpm biome check && pnpm types:check && pnpm knip",
    "seed": "convex run seed:seedDishes",
    "seed:clear": "convex run seed:clearDishes",
    "prepare": "husky"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.13.8",
    "@convex-dev/react-query": "^0.1.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.0",
    "husky": "^9.1.7",
    "knip": "^5.82.1",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.6",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@tanstack/devtools-vite": "^0.3.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.1.2",
    "jsdom": "^27.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "wrangler": "^4.40.3"
  }
}
