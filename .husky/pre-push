echo "Running pre-push checks..."

# Format and lint, then fix what can be fixed automatically
echo "Checking code with Vite+..."
pnpm exec vp check --fix

# Check if there are any changes to commit
if ! git diff --quiet; then
	echo "Lint errors detected. Amending commit..."
	git add -u
	git commit --amend --no-edit --no-verify
	echo "✅ Commit amended with lint errors fixed"
fi


# Run type checking
echo "Checking TypeScript types..."
pnpm types:check || {
  echo "❌ TypeScript type check failed. Please fix type errors before pushing."
  exit 1
}

# Run Knip
echo "Checking for unused code with Knip..."
pnpm knip || {
  echo "❌ Knip check failed. Please review unused code before pushing."
  exit 1
}

echo "✅ All pre-push checks passed!"

